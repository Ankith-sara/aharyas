# Backend API base URL — used both server-side (Server Components,
# ISR data fetching in lib/api/) and client-side (axios instance in
# src/context/api.ts). Must be NEXT_PUBLIC_ prefixed to be readable
# in the browser bundle.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Public Razorpay key ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# Public Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Canonical site URL, used for metadataBase / Open Graph / sitemap
NEXT_PUBLIC_SITE_URL=https://www.aharyas.com
