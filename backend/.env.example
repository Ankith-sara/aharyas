# MongoDB connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Port for the Express server to run on
PORT=3040

# JWT Secrets for Authentication
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Frontend Application URL
FRONTEND_URL=http://localhost:3141

# Next.js on-demand cache revalidation (see services/CacheRevalidationService.js)
# FRONTEND_REVALIDATE_URL points at the frontend's revalidate route handler;
# REVALIDATE_SECRET must match the same value set in frontend/.env
FRONTEND_REVALIDATE_URL=http://localhost:3141/api/revalidate
REVALIDATE_SECRET=your_shared_revalidate_secret_here

# ImageKit Credentials for File Uploads
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint

# Razorpay Credentials for Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_SECRET_KEY=your_razorpay_secret_key

# Email Credentials for SMTP Notifications
EMAIL_USER=your_smtp_email_address
EMAIL_PASS=your_smtp_email_password_or_app_passcode

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# Groq API Key for AI Integration
GROQ_API_KEY=your_groq_api_key_here

# Fast2SMS API Key for OTP SMS sending
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# WhatsApp Community / Group Link
WHATSAPP_GROUP_LINK=your_whatsapp_group_link_here

# Upstash Redis Credentials for rate limiting and cache
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
REDIS_URL=your_redis_connection_url_here

# Vercel Integration Tokens (Analytics)
VERCEL_ACCESS_TOKEN=your_vercel_access_token_here
VERCEL_PROJECT_ID=your_vercel_project_id_here
